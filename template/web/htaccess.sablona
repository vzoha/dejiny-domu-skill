# Šablona – dist/.htaccess z ní vyrábí scripts/nasadit-hukot.sh. Jen pro sdílený hosting s Apachem (např. hukot.net).
# Lehké přihlášení jako v nginx.sablona.conf: bez cookie "rodokmen" s otiskem (SHA-256) odpovědi vrátí 401
# a místo stránky přihlašovací formulář. Samotná odpověď tu není. U otevřeného webu skript blok „brána“ vynechá.
Options -Indexes
AddDefaultCharset utf-8
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  # Prohlížeč se u každé stránky a obrázku zeptá serveru, jestli se nezměnily (nezměněné vrátí server krátce jako 304),
  # takže po nasazení je hned vidět nová verze. Soubory v /_astro/ mají v názvu otisk obsahu – smí se držet napořád.
  Header set Cache-Control "no-cache"
  <If "%{REQUEST_URI} =~ m#^/_astro/#">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>
  <Files "prihlaseni.html">
    Header always set Cache-Control "no-store"
  </Files>
</IfModule>

RewriteEngine On
# http → https (TLS ukončuje proxy hostingu, Apache to pozná jen z hlavičky)
RewriteCond %{HTTP:X-Forwarded-Proto} =http
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# brána
ErrorDocument 401 /prihlaseni.html
RewriteCond %{REQUEST_URI} !^/prihlaseni\.html$
RewriteCond %{HTTP_COOKIE} !(^|;\s*)rodokmen={{HASH}}(;|$)
RewriteRule ^ - [R=401,L]
# /brána
