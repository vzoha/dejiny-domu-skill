---
import Base from '../layouts/Base.astro';
import HouseMap from '../components/HouseMap.astro';
import Timeline from '../components/Timeline.astro';
import { stats, config, village, mainHouse, houseList, href, houseTitle } from '../lib/data.js';
import { frontmatter as pribeh } from '../generated/pribeh.md';
const uvod = config.uvod ?? {};
const cards = config.zajimavosti_na_uvodu ?? [];
const hasMap = houseList.some((h) => h.lat != null) || village.lat != null;
---
<Base title="" wide>
  <h1>{config.nazev || (mainHouse ? `${village.name} ${houseTitle(mainHouse)}` : village.name) || 'Dějiny domu'}</h1>

  {(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        {uvod.nadpis && <h2>{uvod.nadpis}</h2>}
        {(uvod.odstavce ?? []).map((t) => <p>{t}</p>)}
        {config.maPribeh && <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || `Přečíst: ${pribeh.title}`} →</a>}
      </div>
      {uvod.foto && (
        <a href={config.maPribeh ? '/pribehy/' : `/img/${uvod.foto}.jpg`}><img src={`/img/${uvod.foto}.jpg`} alt={uvod.foto_popis || ''} /></a>
      )}
    </section>
  )}

  {config.maPribeh && !(uvod.nadpis || uvod.odstavce?.length) && (
    <section class="teaser">
      <div>
        <h2>{pribeh.title}</h2>
        {pribeh.lead && <p>{pribeh.lead}</p>}
        <a class="btn" href="/pribehy/">{config.pribeh?.tlacitko || 'Přečíst příběh'} →</a>
      </div>
    </section>
  )}

  <div class="stats">
    {stats.oldest && <div><strong>{stats.oldest}</strong>nejstarší zmínka</div>}
    <div><strong>{stats.owners}</strong>známých držitelů</div>
    <div><strong>{stats.people}</strong>obyvatel</div>
    <div><strong>{stats.records}</strong>zápisů z pramenů</div>
    {stats.maps > 0 && <div><strong>{stats.maps}</strong>starých map</div>}
  </div>

  {mainHouse && (
    <>
      <h2>{houseTitle(mainHouse)}</h2>
      {mainHouse.desc && <p class="lead">{mainHouse.desc}</p>}
      {mainHouse.events.length > 0 && <Timeline events={mainHouse.events.slice(0, 6)} />}
      <p><a class="btn" href={href.house(mainHouse.slug)}>Celé dějiny domu →</a></p>
    </>
  )}

  {cards.length > 0 && (
    <>
      <h2>Zajímavosti</h2>
      <div class="grid2">
        {cards.map((c) => (
          <a class="card card-link" href="/zajimavosti/"><h3>{c.nadpis}</h3><p class="small muted">{c.text}</p></a>
        ))}
      </div>
      <p><a href="/zajimavosti/">Všechny zajímavosti →</a></p>
    </>
  )}

  {village.name && (
    <>
      <h2>Obec {village.name}</h2>
      {village.desc && <p class="lead">{village.desc}</p>}
      <p><a href="/obec/">Dějiny obce →</a></p>
    </>
  )}

  {hasMap && (
    <>
      <HouseMap height="420px" compact />
      <p><a href="/mapa/">Velká mapa →</a> · <a href="/mapy/">staré mapy a letecké snímky →</a></p>
    </>
  )}
</Base>
