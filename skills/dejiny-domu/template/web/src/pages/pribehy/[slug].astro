---
import Base from '../../layouts/Base.astro';
import Doplnky from '../../components/Doplnky.astro';
import { config, mainHouse, houseList, href } from '../../lib/data.js';

// Další příběhy: data/pribeh_<slug>.md (export_web.py je kopíruje do src/generated/pribehy/).
export function getStaticPaths() {
  const files = import.meta.glob('../../generated/pribehy/*.md', { eager: true });
  return Object.entries(files).map(([path, mod]) => ({
    params: { slug: path.split('/').pop().replace(/\.md$/, '') },
    props: { mod },
  }));
}
const { mod } = Astro.props;
const { Content, frontmatter } = mod;
const { slug } = Astro.params;
const ostatni = (config.dalsiPribehy ?? []).filter((p) => p.slug !== slug)
  .map((p) => ({ href: `/pribehy/${p.slug}/`, title: p.title, lead: p.lead }));
// Protějšek tlačítka „Přečíst příběh domu/obce“ na stránce domu a obce. Příběh domu = slug cp<adresa domu> (ev. 3 → cpev-3).
const dum = slug === config.pribeh?.hlavni && mainHouse ? mainHouse : houseList.find((h) => slug === `cp${h.slug}`);
const zpet = slug === 'obec' ? { href: '/obec/', text: 'Dějiny obce' } : dum ? { href: href.house(dum.slug), text: 'Dějiny domu' } : null;
---
<Base title={frontmatter.title}>
  <p class="crumbs"><a href="/pribehy/">Příběhy</a></p>
  <h1>{frontmatter.title}</h1>
  {frontmatter.lead && <p class="lead">{frontmatter.lead}</p>}
  <div class="prose prose-story"><Content /></div>
  <Doplnky misto="pribeh" slug={slug} />

  {(ostatni.length > 0 || zpet) && (
    <div class="next-step">
      {ostatni.length > 0 && <>
        <p><strong>Další příběhy</strong></p>
        <ul class="story-list">
          {ostatni.map((p) => <li><a href={p.href}>{p.title}</a>{p.lead && <> – {p.lead}</>}</li>)}
        </ul>
      </>}
      <p>{zpet && <a class="btn" href={zpet.href}>{zpet.text} →</a>} <a class="btn btn-ghost" href="/zajimavosti/">Zajímavosti →</a></p>
    </div>
  )}
</Base>
