---
import Base from '../../layouts/Base.astro';
import Record from '../../components/Record.astro';
import Timeline from '../../components/Timeline.astro';
import RecLinks from '../../components/RecLinks.astro';
import HouseMap from '../../components/HouseMap.astro';
import { houses, records, dateKey, village, houseTitle, statusClass, config, mainHouse } from '../../lib/data.js';

export function getStaticPaths() {
  return Object.keys(houses).map((slug) => ({ params: { slug } }));
}
const h = houses[Astro.params.slug];
const recs = h.records.filter((r) => records[r]).sort((a, b) => dateKey(records[a].date) - dateKey(records[b].date));
---
<Base title={`${village.name} ${houseTitle(h)}`} description={h.desc}>
  <p class="crumbs"><a href="/domy/">Domy</a> · <span>{village.name}</span></p>
  <h1>{village.name} čp. {h.cp}{h.name && <span class="muted"> – {h.name}</span>}</h1>
  <div class="chips">
    {h.kind && <span class="chip">{h.kind}</span>}
    <span class={`chip ${statusClass(h.st)}`}>{h.status}</span>
  </div>
  {h.desc && <p class="lead">{h.desc}</p>}
  {(() => {
    const st = mainHouse && mainHouse.cp === h.cp && config.maPribeh ? (config.pribeh?.hlavni ? `/pribehy/${config.pribeh.hlavni}/` : '/pribehy/')
      : (config.dalsiPribehy ?? []).some((p) => p.slug === `cp${h.cp}`) ? `/pribehy/cp${h.cp}/` : null;
    return st && <p><a class="btn" href={st}>Přečíst příběh domu →</a></p>;
  })()}
  {h.note && <p class="note">{h.note}</p>}

  {h.numbers.length > 0 && (
    <>
      <h2>Čísla domu v čase</h2>
      <ul class="facts">{h.numbers.map((n) => <li><strong>{n.num}</strong> <span class="muted">({n.when})</span></li>)}</ul>
    </>
  )}

  {h.events.length > 0 && (<><h2>Časová osa</h2><Timeline events={h.events} /></>)}

  {h.owners.length > 0 && (
    <>
      <h2>Držitelé</h2>
      <div class="table-box"><table>
        <thead><tr><th>Od</th><th>Do</th><th>Držitel</th><th>Jak dům získal</th><th>Doklad</th></tr></thead>
        <tbody>
          {h.owners.map((o) => (
            <tr>
              <td class="small" style="white-space:nowrap">{o.since}</td>
              <td class="small" style="white-space:nowrap">{o.until}</td>
              <td>{o.name}{o.note && <div class="small muted">{o.note}</div>}</td>
              <td class="small">{o.how}</td>
              <td><div class="src-line"><span class={`chip ${statusClass(o.st)}`}>{o.status}</span><RecLinks ids={o.records} /></div></td>
            </tr>
          ))}
        </tbody>
      </table></div>
    </>
  )}

  {h.people.length > 0 && (
    <>
      <h2>Obyvatelé</h2>
      <div class="grid2">
        {h.people.map((p) => (
          <div class="card">
            <h3>{p.name} {p.years && <span class="muted small">{p.years}</span>}</h3>
            {p.role && <p class="small"><strong>{p.role}</strong></p>}
            {p.facts.length > 0 && <ul class="facts small">{p.facts.map((f) => <li>{f}</li>)}</ul>}
            {p.note && <p class="small muted">{p.note}</p>}
            <p class="small src-line"><span class={`chip ${statusClass(p.st)}`}>{p.status}</span><RecLinks ids={p.records} /></p>
          </div>
        ))}
      </div>
    </>
  )}

  {h.lat != null && (<><h2>Kde dům stojí</h2><HouseMap height="380px" compact focus={h.slug} /></>)}

  {h.docs.length > 0 && (
    <>
      <h2>Fotografie a dokumenty</h2>
      <div class="docs">{h.docs.map((d) => <figure><a href={`/img/${d.img}.jpg`} target="_blank" rel="noopener"><img src={`/img/${d.img}.jpg`} alt={d.caption} loading="lazy" /></a><figcaption>{d.caption}</figcaption></figure>)}</div>
    </>
  )}

  <h2>Prameny</h2>
  {recs.length ? <div class="recs">{recs.map((r) => <Record id={r} showHouses exclude={h.slug} />)}</div>
    : <p class="muted">K tomuto domu zatím nemáme přečtený zápis.</p>}
</Base>
